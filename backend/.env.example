# Copy to .env and fill in values. Loaded by godotenv at server start.

# Auth — set to bypass x-token-user-email proxy header in local dev
DEBUG_AUTH_EMAIL=

# BMM (Auth0 client credentials grant)
BMM_AUTH0_BASE_URL=
BMM_CLIENT_ID=
BMM_CLIENT_SECRET=
BMM_AUDIENCE=
BMM_BASE_URL=
BMM_INT_BASE_URL=
# Optional: skips the Auth0 token exchange entirely
BMM_DEBUG_TOKEN=

# BCC Members (Core API, Auth0 client credentials grant). Needs persons#read
# (and persons.name#read for search). With the client empty, contributor
# search finds no one.
MEMBERS_API_URL=https://api.bcc.no
MEMBERS_AUTH0_BASE_URL=https://login.bcc.no/
MEMBERS_AUDIENCE=api.bcc.no
MEMBERS_CLIENT_ID=
MEMBERS_CLIENT_SECRET=

# Temporal
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
QUEUE=

# Vidispine / Cantemo
VIDISPINE_BASE_URL=
VIDISPINE_USERNAME=
VIDISPINE_PASSWORD=
CANTEMO_URL=
CANTEMO_TOKEN=

# Playout Studio Content Manifest API
PLAYOUT_API_URL=https://api.playout.studio
PLAYOUT_API_KEY=
PLAYOUT_TENANT_ID=

# Filesystem paths
TEMP_PATH=
STATIC_FILE_PATH=
CONFIG_ROOT=
OVERLAYS_DIR=
SUBTITLE_STYLES_DIR=

# Misc
DEBUG=
